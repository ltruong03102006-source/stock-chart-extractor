{
  "name": "stock-chart-extractor",
  "version": "0.1.0",
  "private": true,
  "description": "Extract chart data and drawing tools from FireAnt.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "tsx tests/test-stock-registry.ts && tsx tests/test-storage-repository.ts && tsx tests/test-export-pipeline.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
